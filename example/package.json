{
  "name": "@eslam-elmeniawy/react-native-common-components-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios --simulator=\"iPhone 17 Pro Max\"",
    "svg": "react-native-vector-image generate",
    "pods": "cd ios && bundle exec pod install --repo-update && cd ..",
    "start": "react-native start",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug",
    "check-dependencies": "rnx-align-deps",
    "fix-dependencies": "rnx-align-deps --write"
  },
  "dependencies": {
    "@d11/react-native-fast-image": "^8.13.0",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/crashlytics": "^23.7.0",
    "@react-native-vector-icons/material-design-icons": "^12.4.0",
    "@react-native/new-app-screen": "^0.83.1",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.9.0",
    "react": "19.1.1",
    "react-native": "^0.82.0",
    "react-native-keyboard-controller": "^1.20.2",
    "react-native-paper": "^5.14.5",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "^4.2.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.15.1",
    "react-native-vector-image": "^0.6.0",
    "react-native-worklets": "^0.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@react-native-community/cli-platform-ios": "^20.0.0",
    "@react-native/babel-preset": "^0.82.0",
    "@react-native/metro-config": "^0.82.0",
    "@react-native/typescript-config": "0.82.0",
    "@types/react": "^19.1.1",
    "react-native-builder-bob": "^0.40.13",
    "react-native-monorepo-config": "^0.1.9",
    "reactotron-react-native": "^5.1.18"
  },
  "engines": {
    "node": ">=20"
  },
  "rnx-kit": {
    "kitType": "app",
    "alignDeps": {
      "requirements": {
        "development": [
          "react-native@0.82"
        ],
        "production": [
          "react-native@0.82"
        ]
      },
      "capabilities": [
        "animation",
        "babel-preset-react-native",
        "community/cli",
        "community/cli-android",
        "community/cli-ios",
        "core",
        "core-android",
        "core-ios",
        "core/metro-config",
        "navigation/native",
        "react",
        "safe-area",
        "screens",
        "svg"
      ]
    }
  }
}
